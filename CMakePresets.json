{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HVC_BUILD_TESTS": "ON",
        "HVC_ENABLE_CLANG_TIDY": "OFF",
        "HVC_ENABLE_SANITIZERS": "OFF",
        "HVC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 - Visual Studio 2022",
      "description": "Visual Studio 2022 multi-configuration build for Windows x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-livekit-quality-gate",
      "displayName": "Windows x64 - LiveKit quality gate",
      "description": "Native LiveKit SDK integration and two-client probe",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "HVC_BUILD_LIVEKIT_QUALITY_GATE": "ON"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Debian/Linux GCC - Debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "HVC_ENABLE_SANITIZERS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Debian/Linux GCC - Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-clang-analysis",
      "displayName": "Debian/Linux Clang - Static analysis",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "HVC_ENABLE_CLANG_TIDY": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "windows-msvc-livekit-quality-gate",
      "configurePreset": "windows-msvc-livekit-quality-gate",
      "configuration": "Release",
      "targets": [
        "hvc_livekit_quality_gate"
      ],
      "jobs": 0
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "jobs": 0
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "jobs": 0
    },
    {
      "name": "linux-clang-analysis",
      "configurePreset": "linux-clang-analysis",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-release",
      "configurePreset": "linux-gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-analysis",
      "configurePreset": "linux-clang-analysis",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-msvc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc"
        },
        {
          "type": "build",
          "name": "windows-msvc-debug"
        },
        {
          "type": "test",
          "name": "windows-msvc-debug"
        }
      ]
    },
    {
      "name": "windows-msvc-release",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc"
        },
        {
          "type": "build",
          "name": "windows-msvc-release"
        },
        {
          "type": "test",
          "name": "windows-msvc-release"
        }
      ]
    },
    {
      "name": "windows-msvc-livekit-quality-gate",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc-livekit-quality-gate"
        },
        {
          "type": "build",
          "name": "windows-msvc-livekit-quality-gate"
        }
      ]
    },
    {
      "name": "linux-gcc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-debug"
        },
        {
          "type": "build",
          "name": "linux-gcc-debug"
        },
        {
          "type": "test",
          "name": "linux-gcc-debug"
        }
      ]
    },
    {
      "name": "linux-gcc-release",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-release"
        },
        {
          "type": "build",
          "name": "linux-gcc-release"
        },
        {
          "type": "test",
          "name": "linux-gcc-release"
        }
      ]
    },
    {
      "name": "linux-clang-analysis",
      "steps": [
        {
          "type": "configure",
          "name": "linux-clang-analysis"
        },
        {
          "type": "build",
          "name": "linux-clang-analysis"
        },
        {
          "type": "test",
          "name": "linux-clang-analysis"
        }
      ]
    }
  ]
}
